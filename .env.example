# Copy to .env and fill in. Only the four uncommented values are required.

# --- TALENT Monitoring account (same login as the pro portal) ---
TALENT_USERNAME=you@example.com
TALENT_PASSWORD=your-portal-password
# Portal API base. Use https://www.talent-monitoring.com/prod-api for the non-pro portal.
#TALENT_BASE_URL=https://pro.talent-monitoring.com/prod-api
# UTC offset sent to the station endpoint.
#TALENT_TIMEZONE=+02:00
#POLL_INTERVAL_SECONDS=300
#HTTP_TIMEOUT_SECONDS=30

# --- MQTT broker ---
MQTT_URL=tcp://mosquitto:1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_CLIENT_ID=tsun2mqtt
#MQTT_BASE_TOPIC=tsun
#MQTT_QOS=0
#MQTT_RETAIN=true

# --- Home Assistant MQTT discovery ---
#HA_DISCOVERY_ENABLED=true
#HA_DISCOVERY_PREFIX=homeassistant
# Unit the portal reports energy counters in (kWh on all portals seen so far).
#ENERGY_UNIT=kWh

# --- Diagnostics ---
# Mirror the untouched API payloads to <base>/<kind>/<id>/raw.
#PUBLISH_RAW=false
#LOG_LEVEL=info
#HEALTH_FILE=/tmp/tsun2mqtt-healthy
#HEALTH_MAX_AGE=900
